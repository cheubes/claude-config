{
  "permissions": {
    "allow": [
      "Bash('/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' *)",
      "Bash(/usr/local/bin/exiftool *)",
      "Bash(awk *)",
      "Bash(bundle exec *)",
      "Bash(cat *)",
      "Bash(chromium-cli *)",
      "Bash(command -v compare)",
      "Bash(command -v magick)",
      "Bash(compare *)",
      "Bash(curl *)",
      "Bash(dig *)",
      "Bash(find *)",
      "Bash(fswatch *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(kill *)",
      "Bash(lessc *)",
      "Bash(ls *)",
      "Bash(magick compare *)",
      "Bash(md5 *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx --yes -p playwright-core node compare.js)",
      "Bash(npx --yes playwright --version)",
      "Bash(npx chromium-cli *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(pip3 *)",
      "Bash(pkill -f \"vite\")",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(which chrome-cli *)",
      "Bash(xxd)",
      "Read(//Applications/**)",
      "Read(//Applications/Google Chrome.app/**)",
      "Read(//Users/christophe/.cache/**)",
      "Read(//Users/christophe/Library/Caches/**)",
      "Read(//tmp/**)",
      "Skill(artifact-design)",
      "Skill(artifact-design:*)",
      "Skill(claude-api:*)",
      "Skill(run)",
      "Skill(run:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -q 'git push' && { echo 'git push bloqué'; exit 1; } || exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE '(rm -[a-z]*r[a-z]*f|rm -[a-z]*f[a-z]*r|git reset --hard|git clean -[fdx]*f|truncate )' && { echo 'Commande destructive bloquée'; exit 1; } || exit 0"
          }
        ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | grep -qE '(\\.env$|\\.env\\.|\\.pem$|\\.key$|id_rsa|id_ed25519|secrets?\\.|credentials)' && { echo 'Fichier sensible détecté, modification bloquée'; exit 1; } || exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude demande une permission\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude a terminé\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh"
}
